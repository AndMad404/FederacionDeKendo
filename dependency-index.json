{
  "schemaVersion": 1,
  "project": "FederacionDeKendo",
  "ignoreGlobs": [
    "dist/**",
    "dist-ssr/**",
    "node_modules/**",
    "playwright-report/**",
    "test-results/**",
    "coverage/**"
  ],
  "rules": [
    {
      "id": "calendar-event-data",
      "changes": [
        "src/app/config/events.ts",
        "src/app/data/calendarEventRegistry.json",
        "src/app/data/calendarEvents.ts",
        "src/app/data/eventTranslations.json",
        "src/app/data/eventTranslations.ts",
        "src/app/utils/calendarDate.*",
        "src/app/utils/calendarEventPresentation.ts",
        "src/app/utils/calendarEvents.ts",
        "src/app/utils/eventArchive.*",
        "src/app/utils/eventArchiveRoutes.*",
        "src/app/utils/eventRoutes.ts",
        "src/app/utils/localizedEvents.ts"
      ],
      "area": "Datos, rutas y filtros de calendario y eventos",
      "tests": [
        "tests/data/calendar-dates.test.mjs",
        "tests/data/calendar-parsing.test.mjs",
        "tests/data/calendar-sync.test.mjs",
        "tests/data/calendar-timezone-localization.spec.ts",
        "tests/data/event-history-filters.test.mjs",
        "tests/data/event-history-sync-contract.test.mjs",
        "tests/data/event-runtime.test.mjs"
      ]
    },
    {
      "id": "calendar-event-ui",
      "changes": [
        "src/app/components/calendar/**",
        "src/app/components/events/**",
        "src/app/components/CalendarSection.tsx",
        "src/app/components/EventPage.tsx",
        "src/app/components/EventSummary.tsx",
        "src/app/components/PastEventsSection.tsx",
        "src/app/components/UpcomingEventsSection.tsx"
      ],
      "area": "Interfaz de calendario, eventos y archivo historico",
      "tests": [
        "tests/behavior/calendar-behavior.spec.ts",
        "tests/behavior/event-history-filters.spec.ts",
        "tests/behavior/events.spec.ts",
        "tests/design/event-action-geometry.spec.ts",
        "tests/design/event-content-layout.spec.ts",
        "tests/design/responsive-reachability.spec.ts",
        "tests/design/shell-geometry.spec.ts"
      ]
    },
    {
      "id": "gallery-data",
      "changes": [
        "src/app/data/eventGalleries.ts",
        "src/app/data/eventGalleryState.json",
        "src/app/data/gallery-asset-hashes.json",
        "src/app/data/gallery.ts",
        "scripts/sync-approved-historical-galleries.mjs",
        "scripts/sync-event-galleries.mjs",
        "public/images/events/**",
        "public/images/gallery/**"
      ],
      "area": "Datos, assets y sincronizacion de galerias",
      "tests": [
        "tests/data/event-gallery-sync.test.mjs",
        "tests/data/event-history-publication.test.mjs",
        "tests/data/event-history-sync-contract.test.mjs",
        "tests/data/gallery-data.test.mjs",
        "tests/data/static-public-content.test.mjs"
      ]
    },
    {
      "id": "gallery-ui",
      "changes": [
        "src/app/components/gallery/**",
        "src/app/components/GallerySection.tsx",
        "src/app/components/HistoricalEventGallery.tsx",
        "src/app/components/Lightbox.tsx",
        "src/app/hooks/useCarousel.ts",
        "src/app/hooks/useGalleryLightbox.ts",
        "src/app/hooks/useModalBehavior.ts",
        "src/app/hooks/usePinchZoom.ts"
      ],
      "area": "Interfaz y comportamiento de galerias",
      "tests": [
        "tests/behavior/events.spec.ts",
        "tests/behavior/lightbox-behavior.spec.ts",
        "tests/design/event-content-layout.spec.ts",
        "tests/design/interaction-states.spec.ts",
        "tests/design/visual-regression.spec.ts",
        "tests/design/shell-geometry.spec.ts"
      ]
    },
    {
      "id": "navigation-shell",
      "changes": [
        "src/app/App.tsx",
        "src/app/components/Footer.tsx",
        "src/app/components/Navbar.tsx",
        "src/app/config/routePresentation.ts",
        "src/app/routeRegistry.client.tsx",
        "src/main.tsx"
      ],
      "area": "Navegacion, rutas y shell compartido",
      "tests": [
        "tests/behavior/accessibility.spec.ts",
        "tests/behavior/events.spec.ts",
        "tests/behavior/navbar-calendar-menu.spec.ts",
        "tests/design/responsive-reachability.spec.ts",
        "tests/design/shell-geometry.spec.ts"
      ]
    },
    {
      "id": "seo-prerender",
      "changes": [
        "src/app/config/seo-data.json",
        "src/app/config/seo.ts",
        "src/entry-server.tsx",
        "scripts/generate-crawler-files.mjs",
        "scripts/generate-route-html.mjs",
        "public/llms.txt",
        "public/robots.txt"
      ],
      "area": "SEO, metadata y prerender",
      "tests": [
        "tests/data/generated-event-structured-data.test.mjs",
        "tests/data/generated-output.test.mjs",
        "tests/data/generated-redirects.test.mjs",
        "tests/data/generated-sitemap.test.mjs",
        "tests/data/generated-translations.test.mjs",
        "tests/data/llms-txt.test.mjs",
        "tests/data/meta-descriptions-approval.test.mjs"
      ]
    },
    {
      "id": "calendar-gallery-automation",
      "changes": [
        "scripts/apply-calendar-editorial-decision.mjs",
        "scripts/correct-calendar-history-range.mjs",
        "scripts/correct-calendar-history.mjs",
        "scripts/sync-calendar-events.mjs",
        ".github/workflows/apply-calendar-editorial-decision.yml",
        ".github/workflows/correct-calendar-history-range.yml",
        ".github/workflows/sync-calendar.yml"
      ],
      "area": "Sincronizacion y automatizacion de calendario y galerias",
      "tests": [
        "tests/architecture/calendar-workflow-architecture.test.mjs",
        "tests/data/calendar-dates.test.mjs",
        "tests/data/calendar-history-correction.test.mjs",
        "tests/data/calendar-parsing.test.mjs",
        "tests/data/calendar-sync.test.mjs",
        "tests/data/event-gallery-sync.test.mjs",
        "tests/data/event-history-editorial-decisions.test.mjs",
        "tests/data/event-history-notifications.test.mjs",
        "tests/data/event-history-publication.test.mjs",
        "tests/data/event-history-reports.test.mjs",
        "tests/data/event-history-sync-contract.test.mjs"
      ]
    },
    {
      "id": "source-module-loader",
      "changes": ["tests/helpers/load-source-module.mjs"],
      "area": "Carga de modulos fuente para pruebas de datos",
      "tests": [
        "tests/data/event-runtime.test.mjs",
        "tests/data/meta-descriptions-approval.test.mjs",
        "tests/data/static-public-content.test.mjs"
      ]
    },
    {
      "id": "design-page-preparation",
      "changes": [
        "tests/design/design-contract.ts",
        "tests/helpers/prepare-page.ts"
      ],
      "area": "Contratos y preparacion de paginas para geometria y comparacion visual",
      "tests": [
        "tests/design/event-action-geometry.spec.ts",
        "tests/design/geometry-contract.spec.ts",
        "tests/design/responsive-reachability.spec.ts",
        "tests/design/shell-geometry.spec.ts",
        "tests/design/visual-regression.spec.ts"
      ]
    },
    {
      "id": "design-content-reachability",
      "changes": ["tests/helpers/content-reachability.ts"],
      "area": "Deteccion de recorte y alcance del contenido responsive",
      "tests": [
        "tests/design/responsive-reachability.spec.ts",
        "tests/design/shell-geometry.spec.ts"
      ]
    },
    {
      "id": "source-style-policy",
      "changes": ["src/**/*.css", "src/**/*.js", "src/**/*.ts", "src/**/*.tsx"],
      "area": "Prohibicion de declaraciones CSS y utilidades Tailwind importantes",
      "tests": ["tests/architecture/repository-policy.test.mjs"]
    },
    {
      "id": "repository-tooling",
      "changes": [
        "package.json",
        "pnpm-lock.yaml",
        "eslint.config.js",
        "tsconfig.json",
        "vite.config.ts",
        "playwright.config.ts",
        "playwright.visual.config.ts",
        ".github/actions/verify-site/action.yml",
        ".github/workflows/ci.yml",
        "scripts/verify-site.mjs"
      ],
      "area": "Tooling, CI y verificacion del repositorio",
      "tests": [
        "tests/architecture/repository-policy.test.mjs",
        "tests/architecture/verify-site.test.mjs"
      ]
    }
  ]
}
