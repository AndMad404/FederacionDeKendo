{
  "name": "federacion-kendo-costa-rica",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/check-llms-txt.mjs",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "postbuild": "node scripts/generate-route-html.mjs",
    "dev": "vite",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "setup:git-hooks": "node scripts/setup-git-hooks.mjs",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "test:data:node": "node --test tests/data/*.test.mjs",
    "test:data": "pnpm run test:data:node && playwright test tests/data",
    "test:behavior": "playwright test tests/behavior",
    "test:design": "playwright test tests/design --grep-invert @visual",
    "test:all": "pnpm run test:architecture && pnpm run test:data && pnpm run test:behavior && pnpm run test:design",
    "test:e2e": "pnpm run test:behavior && pnpm run test:design",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:generated": "node --test tests/data/generated-output.test.mjs",
    "test:llms": "node --test tests/data/llms-txt.test.mjs",
    "test:meta-descriptions": "node --test tests/data/meta-descriptions-approval.test.mjs",
    "test:lint-priorities": "node --test tests/architecture/style-priority-guard.test.mjs",
    "test:unit": "pnpm run test:architecture && pnpm run test:data:node",
    "test:sync-directed": "node --test tests/data/calendar-sync.test.mjs tests/data/event-gallery-sync.test.mjs tests/data/event-history-sync-contract.test.mjs tests/architecture/calendar-workflow-architecture.test.mjs",
    "test:unit:without-sync": "node --test tests/data/event-history-filters.test.mjs tests/data/calendar-history-correction.test.mjs tests/data/gallery-data.test.mjs",
    "test:unit:without-history-correction": "node --test tests/data/calendar-sync.test.mjs tests/data/event-gallery-sync.test.mjs tests/data/event-history-filters.test.mjs tests/data/event-history-sync-contract.test.mjs tests/data/gallery-data.test.mjs tests/architecture/calendar-workflow-architecture.test.mjs",
    "test:event-galleries": "node --test tests/data/event-gallery-sync.test.mjs",
    "typecheck": "tsc --noEmit",
    "sync:calendar": "node scripts/sync-calendar-events.mjs",
    "apply:calendar-decision": "node scripts/apply-calendar-editorial-decision.mjs",
    "correct:calendar-history": "node scripts/correct-calendar-history.mjs",
    "correct:calendar-history-range": "node scripts/correct-calendar-history-range.mjs",
    "images:responsive": "node scripts/generate-responsive-images.mjs && node scripts/generate-gallery-asset-hashes.mjs",
    "images:optimize-delivered": "node scripts/optimize-delivered-images.mjs"
  },
  "dependencies": {
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "sharp": "0.35.2",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
