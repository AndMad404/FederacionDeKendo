{
  "name": "federacion-kendo-costa-rica",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "postbuild": "node scripts/generate-route-html.mjs",
    "dev": "vite",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:generated": "node --test tests/generated-output.test.mjs",
    "test:unit": "node --test tests/calendar-sync.test.mjs tests/event-gallery-sync.test.mjs tests/event-history-filters.test.mjs tests/event-history-sync-contract.test.mjs tests/calendar-history-correction.test.mjs tests/gallery-data.test.mjs tests/calendar-workflow-architecture.test.mjs",
    "test:sync-directed": "node --test tests/calendar-sync.test.mjs tests/event-gallery-sync.test.mjs tests/event-history-sync-contract.test.mjs tests/calendar-workflow-architecture.test.mjs",
    "test:unit:without-sync": "node --test tests/event-history-filters.test.mjs tests/calendar-history-correction.test.mjs tests/gallery-data.test.mjs",
    "test:unit:without-history-correction": "node --test tests/calendar-sync.test.mjs tests/event-gallery-sync.test.mjs tests/event-history-filters.test.mjs tests/event-history-sync-contract.test.mjs tests/gallery-data.test.mjs tests/calendar-workflow-architecture.test.mjs",
    "test:event-galleries": "node --test tests/event-gallery-sync.test.mjs",
    "typecheck": "tsc --noEmit",
    "sync:calendar": "node scripts/sync-calendar-events.mjs",
    "apply:calendar-decision": "node scripts/apply-calendar-editorial-decision.mjs",
    "correct:calendar-history": "node scripts/correct-calendar-history.mjs",
    "correct:calendar-history-range": "node scripts/correct-calendar-history-range.mjs",
    "images:responsive": "node scripts/generate-responsive-images.mjs && node scripts/generate-gallery-asset-hashes.mjs"
  },
  "dependencies": {
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "sharp": "0.35.2",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
